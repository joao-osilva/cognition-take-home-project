# Neon Postgres connection string
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Vercel Blob (private store; auto-provisioned by the Vercel Blob integration in deployments)
BLOB_READ_WRITE_TOKEN=

# Shared API key for the machine-to-machine /api/flags read endpoint
FLAGS_API_KEY=

# Inngest (auto-provisioned by the Vercel integration in deployments)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Local dev: set INNGEST_DEV=1 (no keys needed; pair with `npx inngest-cli dev` to run functions)
INNGEST_DEV=

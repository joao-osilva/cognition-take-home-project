direction: down

vars: {
  d2-config: {
    sketch: true
    theme-id: 105
    layout-engine: elk
  }
}

classes: {
  external: {
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 8
    }
  }
}

operators: Ops team\noperators, approvers, admins {
  shape: person
  style.fill: "#f6f1e7"
}

services: Product services\nread feature flags {
  class: external
  style.multiple: true
}

clerk: Clerk\nauthentication, roles {
  class: external
  icon: ./icons/clerk.svg
}

github: GitHub\ncode, CI/CD {
  class: external
  icon: ./icons/github.svg
}

inngest: Inngest\nbackground jobs {
  class: external
  icon: ./icons/inngest.png
}

blob: Vercel Blob\nprivate KYC documents {
  class: external
  icon: ./icons/vercel.svg
}

neon: Neon Postgres\ndomain + audit + platform tables {
  shape: cylinder
  style: {
    fill: "#efe9db"
    stroke: "#5c5748"
  }
  icon: ./icons/neon.svg
}

platform: "Internal tools platform" {
  style: {
    fill: "#fdfaf3"
    stroke: "#5c5748"
    border-radius: 12
  }
  icon: ./icons/nextjs.svg

  label: "Internal tools platform\nNext.js on Vercel"

  kyc: KYC review {style.fill: "#efe9db"}
  refunds: Refunds {style.fill: "#efe9db"}
  flags: Feature flags {style.fill: "#efe9db"}

  kernel: Shared kernel\nRBAC, maker-checker approvals,\naudit log, notifications {
    style: {
      fill: "#1c1a16"
      stroke: "#1c1a16"
      font-color: "#faf6ec"
      border-radius: 8
    }
  }

  kyc -> kernel
  refunds -> kernel
  flags -> kernel
}

operators -> platform: use the apps over HTTPS
operators -> clerk: sign in {style.stroke-dash: 3}
clerk -> platform: session + roles
services -> platform: GET /api/flags\nper-consumer API keys
platform -> neon: reads / audited writes
platform.kyc -> blob: upload / stream documents {style.stroke-dash: 3}
inngest -> platform: SLA reminders, settlement, digests
github -> platform: deploys via Vercel {style.stroke-dash: 3}

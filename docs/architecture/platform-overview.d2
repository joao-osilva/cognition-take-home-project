direction: down

vars: {
  d2-config: {
    sketch: true
    theme-id: 105
    layout-engine: elk
  }
}

classes: {
  external: {
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 8
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#efe9db"
      stroke: "#5c5748"
      border-radius: 8
    }
  }
  kernel: {
    style: {
      fill: "#1c1a16"
      stroke: "#1c1a16"
      font-color: "#faf6ec"
      border-radius: 8
    }
  }
}

operators: Ops users\n(operators, approvers, admins) {
  shape: person
  style.fill: "#f6f1e7"
}

services: Product services {
  class: external
  style.multiple: true
}

clerk: Clerk\nauthentication {
  class: external
}

inngest: Inngest\nbackground jobs {
  class: external
}

blob: Vercel Blob\nprivate KYC documents {
  class: external
}

web: "Next.js host (apps/web)" {
  style: {
    fill: "#fdfaf3"
    stroke: "#5c5748"
    border-radius: 12
  }

  shell: App shell\nsidebar, RBAC-filtered nav, inbox {
    style.fill: "#efe9db"
  }

  apps: "App packages (packages/apps/*)" {
    style: {
      fill: "#fdfaf3"
      stroke-dash: 3
      stroke: "#8a8577"
      border-radius: 10
    }
    kyc: KYC review {style.fill: "#efe9db"}
    refunds: Refunds {style.fill: "#efe9db"}
    flags: Feature flags {style.fill: "#efe9db"}
  }

  kernel: "Kernel (packages/core)" {
    class: kernel
    action: "defineAction()\nauth → roles → validation → domain → audit" {class: kernel}
    approvals: Approval engine\nmaker-checker, SoD {class: kernel}
    audit: Audit writer\nappend-only {class: kernel}
    notify: Notifications {class: kernel}
    config: App config {class: kernel}
  }

  api: "/api/flags\nread-only, per-consumer API keys" {
    style.fill: "#efe9db"
  }

  shell -> apps
  apps -> kernel: every mutation
}

db: Neon Postgres {
  class: store
  domain: Domain tables\ncases, refunds, flags {
    style.fill: "#fdfaf3"
    style.stroke: "#8a8577"
  }
  platform: Platform tables\nusers, audit_log, approvals,\nnotifications, app_config, api_keys {
    style.fill: "#fdfaf3"
    style.stroke: "#8a8577"
  }
}

operators -> web.shell: HTTPS
operators -> clerk: sign in {style.stroke-dash: 3}
clerk -> web.shell: session + roles
clerk -> db.platform: user sync webhook {style.stroke-dash: 3}

web.kernel -> db
web.apps -> db.domain: reads
web.apps.kyc -> blob: upload / stream\n(audited reads) {style.stroke-dash: 3}

inngest -> web.kernel: SLA reminders, settlement,\nfan-outs, daily digest

services -> web.api: GET flags snapshot
web.api -> db: key lookup + flag read

direction: down

vars: {
  d2-config: {
    sketch: true
    theme-id: 105
    layout-engine: elk
  }
}

classes: {
  layer: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#8a8577"
    }
  }
  spacer: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: transparent
    }
  }
  external: {
    width: 280
    height: 110
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 8
    }
  }
  service: {
    width: 280
    height: 150
    label.near: top-center
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 8
    }
  }
  band: {
    height: 150
    label.near: top-center
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 8
    }
  }
  group: {
    label.near: top-center
    style: {
      fill: "#f6f1e7"
      stroke: "#8a8577"
      border-radius: 10
      stroke-dash: 3
    }
  }
  module: {
    style: {
      fill: "#efe9db"
      stroke: "#5c5748"
      border-radius: 6
    }
  }
}

layout: "" {
  class: layer
  grid-rows: 4
  grid-columns: 3
  horizontal-gap: 160
  vertical-gap: 110

  s1: "" {class: spacer}
  consumers: Consumers {
    class: layer
    width: 1468
    grid-columns: 3
    grid-gap: 120

    cgap: "" {
      class: spacer
      width: 280
      height: 110
    }
    operators: Ops team\noperators, approvers, admins {
      class: external
    }

    services: Product services\nread feature flags {
      class: external
      style.multiple: true
    }
  }
  s2: "" {class: spacer}

  s3: "" {class: spacer}
  auth: "" {
    class: layer
    width: 1468
    grid-columns: 3
    grid-gap: 120

    agap: "" {
      class: spacer
      width: 280
      height: 150
    }
    clerk: Clerk\nauthentication, roles {
      class: service
      icon: ./icons/clerk.svg
    }
    gap: "" {
      class: spacer
      width: 280
      height: 150
    }
  }
  s4: "" {class: spacer}

  jobs: "" {
    class: layer
    inngest: Inngest\nbackground jobs {
      class: service
      icon: ./icons/inngest.png
    }
  }
  platform: "Internal tools platform" {
    grid-rows: 3
    grid-gap: 40
    label.near: top-center
    style: {
      fill: "#fdfaf3"
      stroke: "#5c5748"
      border-radius: 12
    }
    icon: ./icons/nextjs.svg

    label: "Internal tools platform\nNext.js on Vercel"

    entry: "" {
      class: layer
      grid-columns: 3
      grid-gap: 120

      jobsapi: "POST /api/inngest\nfunction invocations" {
        class: module
        width: 280
      }
      web: App routes\nserver actions {
        class: module
        width: 280
      }
      api: "GET /api/flags\nREST, API-key auth" {
        class: module
        width: 280
      }
    }

    apps: Apps {
      class: group
      grid-columns: 3
      grid-gap: 30

      kyc: KYC review {class: module; width: 340}
      refunds: Refunds {class: module; width: 340}
      flags: Feature flags {class: module; width: 340}
    }

    packages: Packages {
      class: group
      grid-columns: 4
      grid-gap: 30

      core: "@repo/core\nRBAC, approvals,\naudit, notifications" {
        width: 245
        style: {
          fill: "#1c1a16"
          stroke: "#1c1a16"
          font-color: "#faf6ec"
          border-radius: 6
        }
      }
      db: "@repo/db\nDrizzle schema" {class: module; width: 245}
      ui: "@repo/ui\ndesign system" {class: module; width: 245}
      config: "@repo/config\nshared tooling" {class: module; width: 245}
    }
  }
  storage: Storage {
    class: layer
    grid-rows: 2
    grid-gap: 40

    neon: Neon Postgres\ndomain + audit + platform tables {
      shape: cylinder
      width: 320
      height: 200
      label.near: top-center
      style: {
        fill: "#efe9db"
        stroke: "#5c5748"
      }
      icon: ./icons/neon.svg
    }

    blob: Vercel Blob\nprivate KYC documents {
      class: service
      icon: ./icons/vercel.svg
    }
  }

  s5: "" {class: spacer}
  github: GitHub\ncode, CI/CD {
    class: band
    icon: ./icons/github.svg
  }
  s6: "" {class: spacer}

  consumers.operators -> auth.clerk: sign in
  auth.clerk -> platform.entry.web: session + roles
  consumers.services -> platform.entry.api: flag reads\nper-consumer API keys
  platform -> storage.neon: reads /\naudited writes
  platform -> storage.blob: KYC documents {style.stroke-dash: 3}
  jobs.inngest -> platform.entry.jobsapi: SLA reminders,\nsettlement, digests
  github -> platform: deploys\nvia Vercel {style.stroke-dash: 3}
}
